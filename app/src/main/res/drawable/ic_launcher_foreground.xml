<?xml version="1.0" encoding="utf-8"?>
<!--
  前景：一张小票 + ¥。
  自适应图标画布是 108x108，但只有中间 72x72 会真正显示出来，
  因此图形控制在 x/y 的 24..82 之间，四周留足被裁的安全边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 小票主体：上方圆角，下方留给出锯齿 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,24L72,24A6,6 0 0 1 78,30L78,72L30,72L30,30A6,6 0 0 1 36,24Z" />

    <!-- 小票底部的锯齿撕口 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,72L36,82L42,72L48,82L54,72L60,82L66,72L72,82L78,72Z" />

    <!-- 票面上的 ¥，用底色描边形成镂空效果 -->
    <path
        android:pathData="M42,32L54,45M66,32L54,45M54,45L54,66M43,52L65,52M43,60L65,60"
        android:strokeColor="#0E4A7A"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
